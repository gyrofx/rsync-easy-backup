{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 105
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "files": {
    "includes": ["**", "!**/build/assets/**/*.js", "!**/dist/**/*", "!**/node_modules/**/*"]
  }
}
