{
  "name": "backup-rsync",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "pack": "bun build ./src/main.ts --compile --outfile dist/rsync-backup",
    "start": "bun run src/main.ts",
    "test": "vitest",
    "lint": "bun run biome lint ./src/; bun run tsc-lint-server",
    "format": "bun run biome format --write .",
    "tsc-lint-server:watch": "bun run tsc-lint-server --watch",
    "tsc-lint-server": "bun run tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@types/nodemailer": "^8.0.2",
    "commander": "^15.0.0",
    "conditional-type-checks": "^1.0.6",
    "date-fns": "^4.4.0",
    "find-process": "^2.1.1",
    "inquirer": "^14.2.3",
    "lodash-es": "^4.18.1",
    "node-ssh": "^13.2.1",
    "nodemailer": "^10.1.0",
    "pretty-bytes": "^7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
